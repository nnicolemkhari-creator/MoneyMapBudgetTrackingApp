<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FB">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- HEADER -->
        <TextView
            android:id="@+id/textHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Transaction"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close"
            android:alpha="0.5"
            app:layout_constraintTop_toTopOf="@id/textHeader"
            app:layout_constraintBottom_toBottomOf="@id/textHeader"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- INCOME / EXPENSE TOGGLE -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:singleSelection="true"
            app:checkedButton="@id/btnExpense"
            app:layout_constraintTop_toBottomOf="@id/textHeader">

            <Button
                android:id="@+id/btnExpense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Expense"
                android:textAllCaps="false"
                android:backgroundTint="#FFFFFF"
                android:textColor="#000000"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp"
                app:cornerRadius="10dp"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>

            <Button
                android:id="@+id/btnIncome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Income"
                android:textAllCaps="false"
                android:backgroundTint="#F0F0F0"
                android:textColor="#666666"
                app:cornerRadius="10dp"
                style="@style/Widget.MaterialComponents.Button.TextButton"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- AMOUNT FIELD -->
        <TextView
            android:id="@+id/labelAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Amount"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/toggleGroup"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/amountEditText"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_selector"
            android:hint="R 0.00"
            android:paddingStart="16dp"
            android:inputType="numberDecimal"
            app:layout_constraintTop_toBottomOf="@id/labelAmount"/>

        <!-- CATEGORY GRID -->
        <TextView
            android:id="@+id/labelCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/amountEditText"
            app:layout_constraintStart_toStartOf="parent"/>

        <GridLayout
            android:id="@+id/categoryGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/labelCategory">

            <!-- FOOD -->
            <LinearLayout
                android:id="@+id/category_food"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:padding="8dp"
                android:orientation="vertical"
                android:background="@drawable/category_selected_bg">
                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_fork_knife"
                    android:background="@drawable/bg_icon_food"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Food"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- TRANSPORT -->
            <LinearLayout
                android:id="@+id/category_transport"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:padding="8dp"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_car"
                    android:background="@drawable/bg_icon_transport"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Transport"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- BILLS -->
            <LinearLayout
                android:id="@+id/category_bills"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:padding="8dp"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_thunder"
                    android:background="@drawable/bg_icon_bills"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bills"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- SHOPPING -->
            <LinearLayout
                android:id="@+id/category_shopping"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:padding="8dp"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_shopping_bag"
                    android:background="@drawable/bg_icon_shopping"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shopping"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- ENTERTAINMENT -->
            <LinearLayout
                android:id="@+id/category_entertainment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:padding="8dp"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_movie"
                    android:background="@drawable/bg_icon_entertainment"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Entertainment"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- HEALTH -->
            <LinearLayout
                android:id="@+id/category_health"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:padding="8dp"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_health"
                    android:background="@drawable/progress_health"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Health"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </GridLayout>

        <!-- ACCOUNT DROPDOWN -->
        <TextView
            android:id="@+id/labelAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Account"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/categoryGrid"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- FIXED: Tag changed to AutoCompleteTextView to match Kotlin class -->
        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/accountDropdown"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="Bank Account"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="@drawable/bg_input_field"
            android:drawableStart="@drawable/ic_wallet"
            android:drawablePadding="12dp"
            android:drawableEnd="@drawable/ic_arrow_drop_down"
            android:inputType="none"
            android:focusable="false"
            app:layout_constraintTop_toBottomOf="@id/labelAccount" />

        <!-- DATE FIELD -->
        <TextView
            android:id="@+id/labelDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/accountDropdown"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/dateEditText"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:drawableEnd="@drawable/ic_calendar"
            android:paddingHorizontal="16dp"
            android:focusable="false"
            android:text="2026/05/06"
            app:layout_constraintTop_toBottomOf="@id/labelDate"/>

        <!-- DESCRIPTION FIELD -->
        <TextView
            android:id="@+id/labelDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Description"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/dateEditText"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/descriptionEditText"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/edittext_bg"
            android:hint="Add a note..."
            android:gravity="top"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/labelDesc"/>

        <!-- SAVE BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveTransactionButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:text="Save Transaction"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#1DB978"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/descriptionEditText"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>